{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Adobe Stock Uploader",
  "version": "0.1.0",
  "identifier": "com.adobe-stock-uploader.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Adobe Stock Uploader",
        "width": 1280,
        "height": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM2M0NFM0RCQzY5MkI0QzUKUldURnRKTEcyK004Tmc5U3VyWmRaRXdpdW5ZWXBOWFRuMkkwME5jNUxCNy9hL0dsSW56TjNZa2kK",
      "endpoints": [
        "https://github.com/spiritEcosse/adobe-stock-uploader/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
