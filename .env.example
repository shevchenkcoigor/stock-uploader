# Copy to .env (git-ignored) and fill in. Real environment variables override this file.
ADOBE_SFTP_HOST=sftp.contributor.adobestock.com
ADOBE_SFTP_PORT=22
ADOBE_SFTP_USER=
ADOBE_SFTP_PASSWORD=

# Optional folders (defaults: <db name>_backups next to the DB, and ./csv)
# ADOBE_BACKUP_DIR=
# ADOBE_CSV_DIR=

# Text put at the start of every title in the CSV ("Generative AI" by default).
# Empty value turns it off: ADOBE_AI_TITLE_LABEL=
# ADOBE_AI_TITLE_LABEL=Generative AI
