#!/usr/bin/env bash
# `main` changes only through a pull request (see CLAUDE.md). Enable once: git config core.hooksPath .githooks
# git feeds "<local ref> <local sha> <remote ref> <remote sha>" lines on stdin.
while read -r _ _ remote_ref _; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "Push to main is blocked. Push a branch and open a pull request." >&2
    exit 1
  fi
done
